---
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'Story Dice — free story-idea generator, writing prompts, no signup',
  description = 'Free story dice + writing-prompt generator: roll characters, settings & objects, spin one-line prompts, would-you-rather and this-or-that. AI-expandable, 100% in your browser, no upload, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const ogImage = new URL('/screenshots/desktop.png', Astro.site).toString()
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz Story Dice',
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Web',
  url: 'https://play.oriz.in/',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Story dice roller',
    'Writing-prompt generator',
    'Would-you-rather generator',
    'This-or-that picker',
    'AI story-seed expansion',
    'Shareable roll links',
  ],
  isAccessibleForFree: true,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="oriz Play" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#c9a24b" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <script is:inline src="/registerSW.js"></script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <OzToolShell site="play" title="Story Dice" wordmarkHref="https://oriz.in" themeColor="#c9a24b">
      <a slot="footer" href="https://github.com/chirag127/oriz-story-dice" rel="noopener">Source</a>
      <div class="wrap">
        <slot />
      </div>
    </OzToolShell>
  </body>
</html>
